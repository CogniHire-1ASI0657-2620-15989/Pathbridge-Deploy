POSTGRES_USER=pathbridge
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ISSUER=identity-service
JWT_AUDIENCE=job-platform-services
JWT_EXPIRATION_MINUTES=60

INTERNAL_API_KEY=replace-with-a-long-random-internal-secret

DECOLECTA_API_KEY=replace-with-your-decolecta-key
JOOBLE_API_KEY=replace-with-your-jooble-key
# Optional: Gap Analysis falls back to deterministic rules when absent.
GROQ_API_KEY=
# Optional: Interview endpoints return 503 when absent.
INTERVIEW_GROQ_API_KEY=
YOUTUBE_DATA_API_KEY=replace-with-your-youtube-api-key

GROQ_MODEL=qwen/qwen3.8-27b
INTERVIEW_GROQ_MODEL=qwen/qwen3.8-27b
# During the first EC2 validation use its Elastic IP. Replace with the HTTPS
# frontend domain when a reverse proxy and DNS are configured.
CORS_ORIGINS=http://IP_PUBLICA_EC2:8080
